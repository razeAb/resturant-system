# Copy this file to printer.env (same folder) on the machine at this restaurant's physical
# location, next to its printer. printer.js reads it on startup - never commit the real
# printer.env (already in .gitignore).

# "usb" for a printer plugged into this machine, "network" for a WiFi/LAN ESC/POS printer.
PRINTER_MODE=usb

# USB mode: vendor/product IDs for the printer (find via Device Manager on Windows, or
# `lsusb` on Linux/Mac). Defaults below match the original hardcoded USB printer.
PRINTER_USB_VENDOR_ID=0x1504
PRINTER_USB_PRODUCT_ID=0x011c

# Network mode: the printer's IP address on the restaurant's WiFi/LAN, and its ESC/POS
# raw-print port (9100 is the standard default for almost every network thermal printer).
PRINTER_NETWORK_HOST=
PRINTER_NETWORK_PORT=9100

# Port this agent itself listens on (whatever calls this service must match this).
PRINTER_SERVICE_PORT=9100
